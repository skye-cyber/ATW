{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atw.local/schemas/env.v1.json",
  "title": "API Test Workbench — Environment",
  "version": "1.0.0",
  "type": "object",
  "required": ["name", "baseUrl", "vars", "roles"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "baseUrl": { "type": "string" },
    "vars": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "guest": { "type": "string" },
        "user": { "type": "string" },
        "premium": { "type": "string" },
        "admin": { "type": "string" }
      }
    },
    "rememberSecrets": { "type": "boolean", "default": false },
    "probeConfig": {
      "type": "object",
      "additionalProperties": { "$ref": "https://atw.local/schemas/probe-config.v1.json" }
    }
  }
}
