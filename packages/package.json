{
  "name": "atw",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm --filter @atw/app dev",
    "build": "pnpm --filter @atw/app build",
    "build:single": "pnpm --filter @atw/app build:single",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @atw/core test:watch",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "check:tailwind": "node scripts/check-tailwind.mjs",
    "docs:dev": "pnpm --filter @atw/docs dev",
    "docs:build": "pnpm --filter @atw/docs build"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^5.0.3",
    "@types/node": "^22.7.5"
  }
}
