{
  "name": "atw",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/core",
    "packages/react",
    "packages/app",
    "packages/docs"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @atw/react",
    "build": "npm run build --workspace @atw/react",
    "build:single": "npm run build:single --workspace @atw/react",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:tailwind": "node scripts/check-tailwind.mjs",
    "docs:dev": "npm run dev --workspace @atw/docs",
    "docs:build": "npm run build --workspace @atw/docs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-virtual": "^3.10.8",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "scheduler": "^0.23.2",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vite-plugin-singlefile": "^2.0.3",
    "vitepress": "^1.4.3",
    "vitest": "^2.1.3",
    "zustand": "^5.0.0"
  }
}
